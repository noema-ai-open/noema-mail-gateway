# NOEMA Mail Gateway — non-secret example configuration
# Never place a mailbox password, app password or token in this file.

# IMAP endpoint. Production uses TLS on a dedicated IMAPS port.
NOEMA_MAIL_IMAP_HOST=imap.example.org
NOEMA_MAIL_IMAP_PORT=993
NOEMA_MAIL_IMAP_TIMEOUT=15

# Mailbox login name. This value is not treated as a secret, but it is personal
# data and should not be committed in a real deployment configuration.
NOEMA_MAIL_ACCOUNT=user@example.org
NOEMA_MAIL_ACCOUNT_ALIAS=primary

# Folder names are configured in their human-readable Unicode form.
NOEMA_MAIL_INBOX_FOLDER=INBOX
NOEMA_MAIL_DRAFTS_FOLDER=Drafts

# Default service paths. Change them only for an isolated test instance.
NOEMA_MAIL_STATE_DIR=/var/lib/noema-mail
NOEMA_MAIL_RUNTIME_DIR=/run/noema-mail

# The current v0.1 implementation loads the password from a systemd credential
# named `gmx_app_password` for backward compatibility with the first production
# deployment. M11 will introduce a generic configurable credential name while
# keeping the legacy name as an explicit compatibility path.